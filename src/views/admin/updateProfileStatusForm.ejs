<!DOCTYPE html>
<html lang="bg">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/common.css" />
    <link rel="stylesheet" href="/css/formsStyles.css" />
    <script src="https://kit.fontawesome.com/13ecc83974.js" crossorigin="anonymous"></script>
    <title>Промяна на статус на профил</title>

    <script>
        async function fetchUserInfo() {
            const username = document.getElementById('userName').value;
            const userInfoDiv = document.getElementById('userInfo');
            const statusSection = document.getElementById('statusSection');
            const submitStatusButton = document.getElementById('submitStatusButton');

            statusSection.style.display = 'none';
            submitStatusButton.style.display = 'none';
            userInfoDiv.textContent = '';

            if (!username) {
                alert("Моля, попълнете потребителското име.");
                return;
            }

            try {
                const response = await fetch('/admin/getUserInfo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username }),
                });

                if (!response.ok) {
                    throw new Error("Грешка при извличане на информацията.");
                }

                const userInfo = await response.json();
                console.log("Получена информация за потребител:", userInfo);
                displayUserInfo(userInfo);
            } catch (error) {
                console.error('Error fetching user info:', error);
                userInfoDiv.textContent = "Не е намерена информация за този потребител.";
            }
        }
        function displayUserInfo(userInfo) {
            const userInfoDiv = document.getElementById('userInfo');
            const statusSection = document.getElementById('statusSection');
            const submitStatusButton = document.getElementById('submitStatusButton');

            if (userInfo.error) {
                userInfoDiv.textContent = userInfo.error;
                return;
            }
            console.log(userInfo);

            userInfoDiv.innerHTML = `
        <p><strong>Имена:</strong> ${userInfo.fullName}</p>
        <p><strong>Текущ статус:</strong> ${userInfo.status}</p>
    `;

            statusSection.style.display = 'block';
            submitStatusButton.style.display = 'block';

            const statusSelect = document.getElementById('statusSelect');
            statusSelect.value = userInfo.statusId || ""; // Задайте съответния `statusId` от информацията за потребителя
            console.log(statusSelect.value);
        }


    </script>
</head>

<body>
    <%- include('../partials/adminHeader') %>

        <%- include('../partials/flashMessages') %>
            <div class="container page-content">
                <h1>Промяна на статус на профил</h1>
                <form id="changeStatusForm" method="POST" action="/admin/update/status">
                    <div class="formInput">
                        <label for="username">Потребителско име</label>
                        <input type="text" name="username" id="userName" placeholder="Въведете потребителско име"
                            required />
                        <button type="button" id="confirmUsernameButton" onclick="fetchUserInfo()">Потвърди</button>
                    </div>

                    <div id="userInfo" class="userInfo"></div>

                    <div class="formInput" id="statusSection" style="display: none;">
                        <label for="statusSelect">Нов статус</label>
                        <select name="status" id="statusSelect" required>
                            <option value="" disabled selected>Изберете статус</option>
                            <option value="1">Активен</option>
                            <option value="2">Неактивен</option>
                            <option value="3">В изчакване</option>
                        </select>
                    </div>

                    <button type="submit" id="submitStatusButton" class="submit" style="display: none;">Запази
                        промяната</button>
                </form>
            </div>


</body>

</html>