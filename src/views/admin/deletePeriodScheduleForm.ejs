<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/common.css" />
    <link rel="stylesheet" href="/css/formsStyles.css" />
    <script src="https://kit.fontawesome.com/13ecc83974.js" crossorigin="anonymous"></script>
    <title>Изтриване на час от учебната програма</title>
</head>

<body>
    <div class="section-updatePeriod">
        <%- include('../partials/adminHeader') %>
            <%- include('../partials/flashMessages') %>
                <div class="page-content">
                    <form id="deletePeriodScheduleForm" action="/admin/delete/periodSchedule" method="POST">
                        <h1>Изтриване на час от учебната програма</h1>
                        <div class="formInput">
                            <label for="selectFaculty">Факултет</label>
                            <select id="selectFaculty" type="text" name="faculty" required>
                                <% for(const faculty of faculties){%>
                                    <option value="<%=faculty.faculty_abbreviation%>">
                                        <%= faculty.faculty_name%>
                                    </option>
                                    <%} %>
                            </select>
                        </div>
                        <div class="formInput">
                            <label for="selectDepartment">Катедра</label>
                            <select id="selectDepartment" name="department">
                            </select>
                        </div>
                        <div class="formInput">
                            <label for="selectSpecialty">Специалност</label>
                            <select id="selectSpecialty" name="selectSpecialty">
                                <option value="none" selected disabled hidden>Изберете специалност</option>

                            </select>
                        </div>
                        <div class="formInput">
                            <label for="selectCourse">Семестър</label>
                            <select name="selectCourse" id="selectCourse">
                                <option value="none" selected disabled hidden>Изберете курс</option>
                            </select>
                        </div>
                    </form>
                </div>
    </div>
    <script src="\js\addStudentFormSelects.js"></script>
    <script src="\js\deletePeriodScheduleSelects.js"></script>
</body>

</html>