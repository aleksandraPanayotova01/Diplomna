<body>
    <div class="section-updateSubjectToHalf">
        <%- include('../partials/adminHeader') %>
            <%- include('../partials/flashMessages') %>
                <div class="page-content">
                    <form id="updateSubjectForm" action="/admin/update/subjectToHalfs" method="POST">
                        <h1>Промяна на преподавател за предмет на половинка</h1>
                        <div class="formInput">
                            <label for="specialtyDropdown">Специалност</label>
                            <select id="specialtyDropdown" name="specialtyId">
                                <option value="none" selected disabled hidden>Изберете специалност</option>

                            </select>
                        </div>
                        <div class="formInput">
                            <label for="selectCourse">Семестър</label>
                            <select name="selectCourse" id="selectCourse" disabled>
                                <option value="">-- Няма избрана специалност --</option>
                            </select>
                        </div>
                </div>


                </form>
    </div>
    </div>

    <script src="\js\updateSubjectToHalfs.js"></script>

