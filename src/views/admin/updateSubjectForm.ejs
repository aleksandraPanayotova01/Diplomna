<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/common.css" />
    <link rel="stylesheet" href="/css/formsStyles.css" />
    <script src="https://kit.fontawesome.com/13ecc83974.js" crossorigin="anonymous"></script>
    <title>Форма за обновяване на предмет</title>
    <style>
        #subjects-table tbody tr:hover {
            font-weight: bold;
            cursor: pointer;
        }

        .input-container {
            margin-top: 10px;
        }

        .input-container label {
            display: block;
            margin-bottom: 5px;
        }

        .input-container input {
            width: 100%;
            padding: 8px;
            margin-bottom: 10px;
        }

        .save-button-container {
            margin-top: 20px;
            text-align: center;
        }

        .save-button-container button {
            padding: 10px 20px;
            background-color: #4CAF50;
            color: white;
            border: none;
            cursor: pointer;
            font-size: 16px;
            border-radius: 5px;
        }

        .save-button-container button:hover {
            background-color: #45a049;
        }
    </style>
</head>

<body>
    <div class="section-addSubject">
        <%- include('../partials/adminHeader') %>
            <%- include('../partials/flashMessages') %>
                <div class="page-content">
                    <h1>Обновяване на предмет</h1>
                    <div class="search-subject">
                        <input type="text" name="subjectSearch" id="subjectSearch" placeholder="Име на предмета">
                        <button type="button" id="subjectSearchButton">Търсене на предмет</button>
                    </div>

                    <div id="subjects-container">
                        <div id="subjects-table-container"></div>
                        <p id="no-results-message" style="display: none;">Няма намерени предмети</p>
                    </div>

                    <div class="save-button-container" id="saveButtonContainer" style="display: none;">
                        <button id="saveChangesButton">Запази промените</button>
                    </div>
                </div>
    </div>

    <script>
        let selectedSubject;
        document.getElementById("subjectSearchButton").addEventListener("click", async function () {
            const searchValue = document.getElementById("subjectSearch").value.trim();
            const tableContainer = document.getElementById("subjects-table-container");
            const noResultsMessage = document.getElementById("no-results-message");
            const saveButtonContainer = document.getElementById("saveButtonContainer");

            tableContainer.innerHTML = "";
            noResultsMessage.style.display = "none";
            saveButtonContainer.style.display = "none";

            if (searchValue) {
                try {
                    const response = await fetch(`/admin/search/subjects`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ subjectSearch: searchValue })
                    });

                    const data = await response.json();

                    if (data.subjects && data.subjects.length > 0) {
                        const table = document.createElement("table");
                        table.id = "subjects-table";

                        const thead = document.createElement("thead");
                        const headerRow = document.createElement("tr");
                        const headerSubjectName = document.createElement("th");
                        headerSubjectName.textContent = "Име на предмета";
                        const headerSubjectAbbreviation = document.createElement("th");
                        headerSubjectAbbreviation.textContent = "Абревиетура";
                        const headerSubjectSpecialty = document.createElement("th");
                        headerSubjectSpecialty.textContent = "Специалност";


                        headerRow.appendChild(headerSubjectName);
                        headerRow.appendChild(headerSubjectAbbreviation);
                        headerRow.appendChild(headerSubjectSpecialty);
                        thead.appendChild(headerRow);
                        table.appendChild(thead);

                        const tbody = document.createElement("tbody");
                        data.subjects.forEach(subject => {
                            const row = document.createElement("tr");

                            const subjectNameCell = document.createElement("td");
                            subjectNameCell.textContent = subject.subject_name;

                            const subjectAbbreviationCell = document.createElement("td");
                            subjectAbbreviationCell.textContent = subject.subject_abbreviation;

                            const subjectSpecialtyCell = document.createElement("td");
                            subjectSpecialtyCell.textContent = subject.specialty_abbreviation;

                            row.appendChild(subjectNameCell);
                            row.appendChild(subjectAbbreviationCell);
                            row.appendChild(subjectSpecialtyCell);

                            row.addEventListener("click", function () {
                                const cells = row.querySelectorAll('td');
                                selectedSubject = cells[0].textContent;
                                const existingInputContainer = document.querySelector(".input-container");
                                if (existingInputContainer) {
                                    existingInputContainer.remove(); // Remove the previously opened input fields
                                }

                                const inputContainer = row.nextElementSibling;

                                if (inputContainer && inputContainer.classList.contains("input-container")) {
                                    inputContainer.remove(); // Remove the input fields
                                } else {
                                    const newInputContainer = document.createElement("div");
                                    newInputContainer.classList.add("input-container");

                                    const nameLabel = document.createElement("label");
                                    nameLabel.textContent = "Ново име на предмета";
                                    const nameInput = document.createElement("input");
                                    nameInput.type = "text";
                                    nameInput.name = "newName";
                                    nameInput.placeholder = "Въведете име на предмета";

                                    const appLabel = document.createElement("label");
                                    appLabel.textContent = "Нова абревиетура";
                                    const appInput = document.createElement("input");
                                    appInput.type = "text";
                                    appInput.name = "newAbbr";
                                    appInput.placeholder = "Въведете абревиетура на предмета";

                                    newInputContainer.appendChild(nameLabel);
                                    newInputContainer.appendChild(nameInput);
                                    newInputContainer.appendChild(appLabel);
                                    newInputContainer.appendChild(appInput);

                                    row.parentNode.insertBefore(newInputContainer, row.nextSibling);
                                }

                                saveButtonContainer.style.display = "block";
                            });



                            tbody.appendChild(row);
                        });
                        table.appendChild(tbody);

                        tableContainer.appendChild(table);
                    } else {
                        noResultsMessage.style.display = "block";
                        noResultsMessage.textContent = "Няма намерени предмети";
                    }
                } catch (error) {
                    console.error("Error fetching subjects:", error);
                }
            } else {
                noResultsMessage.style.display = "block";
                noResultsMessage.textContent = "Моля, въведете име на предмет за търсене";
            }
        });

        document.getElementById("saveChangesButton").addEventListener("click", async function () {
            const newNameValue = document.querySelector('input[name="newName"]').value;
            const newAbbrValue = document.querySelector('input[name="newAbbr"]').value;


            const response = await fetch(`/admin/update/subject`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ oldName: selectedSubject, newName: newNameValue, newAbbreviation: newAbbrValue })
            });
            alert("Промените са запазени успешно!");
        });
    </script>
</body>

</html>