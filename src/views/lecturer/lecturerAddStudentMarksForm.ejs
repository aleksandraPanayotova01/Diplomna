<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/common.css" />
    <link rel="stylesheet" href="/css/formsStyles.css" />
    <script src="https://kit.fontawesome.com/13ecc83974.js" crossorigin="anonymous"></script>
    <title>Добавяне на оценка от преподавател</title>
    <style>
        .form-container {
            max-width: 600px;
            margin: auto;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
        }

        select,
        input {
            width: 100%;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
    </style>
</head>

<body>
    <%- include('../partials/lecturerHeader') %>
        <%- include('../partials/flashMessages') %>

            <div class="form-container">
                <h2>Добавяне на оценка от преподавател</h2>
                <form id="addMarkForm" action="/lecturer/add/marks" method="POST">

                    <div class="formInput">
                        <label for="selectFaculty">Факултет</label>
                        <select id="selectFaculty" name="faculty" required>
                            <% for(const faculty of faculties){ %>
                                <option value="<%= faculty.faculty_abbreviation %>">
                                    <%= faculty.faculty_name %>
                                </option>
                                <% } %>
                        </select>
                    </div>

                    <div class="formInput">
                        <label for="selectDepartment">Катедра</label>
                        <select id="selectDepartment" name="department"></select>
                    </div>

                    <div class="formInput">
                        <label for="selectSpecialty">Специалност</label>
                        <select id="selectSpecialty" name="specialty">
                            <option value="none" selected disabled hidden>Изберете специалност</option>
                        </select>
                    </div>
                    <div class="formInput">
                        <label for="selectCourse">Семестър</label>
                        <select name="selectCourse" id="selectCourse">
                            <option value="none" selected disabled hidden>Изберете курс</option>
                        </select>
                    </div>

                </form>
            </div>

            <script src="/js/lecturerAddStudentMarkSelects.js"></script>
</body>

</html>